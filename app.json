{
  "expo": {
    "name": "ヒストラリ",
    "slug": "historary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "historary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ryuryu0718.historary",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "日記に添える写真を選ぶために写真ライブラリへのアクセスを使用します。",
        "NSCameraUsageDescription": "日記に添える写真を撮影するためにカメラを使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ryuryu0718.historary",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "日記に添える写真を選ぶために写真ライブラリへのアクセスを許可してください。",
          "cameraPermission": "日記に添える写真を撮影するためにカメラの使用を許可してください。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "dccb2959-0ef6-4f21-bac8-ccc07c9cecbd"
      },
      "router": {}
    },
    "owner": "ryuryu07"
  }
}
